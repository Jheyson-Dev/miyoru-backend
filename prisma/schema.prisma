// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  HUMAN
  BOT
  API
}

model User {
  id             String    @id @default(cuid())
  userType       UserType  @default(HUMAN) @map("user_type")
  displayName    String    @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  isActive       Boolean   @default(false) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  lastActivityAt DateTime? @map("last_activity_at")
  metadata       Json?
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  emailVerifications EmailVerifications[]
  passwordResets     PasswordResets[]
  sessions           Sessions[]
  userRoles          UserRoles[]
  humanProfile       HumanProfile?
  serviceProfiles    ServiceProfiles?

  @@map("users")
}

model HumanProfile {
  userId        String    @id @map("user_id")
  username      String    @unique
  fullName      String    @map("full_name")
  bio           String?
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  passwordHash  String    @map("password_hash")
  phone         String?
  birthDate     DateTime? @map("birth_date")
  preferences   Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("human_profiles")
}

enum ServiceType {
  TELEGRAM
  DISCORD
  INTERNAL_API
  WHATSAPP
}

model ServiceProfiles {
  userId      String      @id @map("user_id")
  serviceType ServiceType @map("service_type")
  externalId  String      @map("external_id")
  config      Json
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("service_profiles")
}

model EmailVerifications {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@map("email_verifications")
}

model RefreshTokens {
  id         String    @id @default(cuid())
  sessionId  String    @map("session_id")
  jtiHash    String    @unique @map("jti_hash")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revoked    Boolean   @default(false)
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  sessions   Sessions? @relation(fields: [sessionId], references: [id])

  @@map("refresh_tokens")
}

model PasswordResets {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String
  expiresAt DateTime @map("expires_at")
  usedAt    Boolean  @default(false) @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

model Sessions {
  id         String    @id @default(cuid())
  userId     String    @map("user_id") // Reference to the User model
  deviceInfo String    @map("device_info") // e.g., "iPhone 12, Chrome Browser"
  ipAddress  String    @map("ip_address") // e.g.,  "192.168.1.1"
  userAgent  String    @map("user_agent") // e.g., "Mozilla/5.0 ..."
  createdAt  DateTime  @default(now()) @map("created_at") // Timestamp when the session was created
  lastUsedAt DateTime  @default(now()) @map("last_used_at") // Timestamp of the last usage
  expiresAt  DateTime  @map("expires_at") // When the session expires
  revoked    Boolean   @default(false) // Indicates if the session has been revoked
  revokedAt  DateTime? @map("revoked_at") // Timestamp when the session was revoked
  location   String?   @map("location") // e.g., "New York, USA"
  platform   String?   @map("platform") // e.g., "Windows", "iOS"
  user       User      @relation(fields: [userId], references: [id])

  refreshTokens RefreshTokens[]

  @@map("sessions")
}

model UserRoles {
  id      String  @id @default(cuid())
  userId  String  @map("user_id")
  roleId  String  @map("role_id")
  user    User    @relation(fields: [userId], references: [id])
  roles   Roles?  @relation(fields: [rolesId], references: [id])
  rolesId String?

  @@unique([userId, roleId], name: "user_role_unique_idx")
  @@map("user_roles")
}

model Roles {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRoles[]
  rolePermissions RolePermissions[]

  @@map("roles")
}

model RolePermissions {
  id            String       @id @default(cuid())
  roleId        String       @map("role_id")
  permissionId  String       @map("permission_id")
  assignedAt    DateTime     @default(now()) @map("assigned_at")
  permissions   Permissions? @relation(fields: [permissionsId], references: [id])
  permissionsId String?
  roles         Roles?       @relation(fields: [rolesId], references: [id])
  rolesId       String?

  @@unique([roleId, permissionId], name: "role_permission_unique_idx")
  @@map("role_permissions")
}

model Permissions {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermissions[]

  @@map("permissions")
}
